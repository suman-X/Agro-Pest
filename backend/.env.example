# Environment Variables for Backend Deployment

# Required: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: PostgreSQL Database URL (Railway provides this automatically)
# POSTGRESQL_URL=postgresql://user:password@host:port/database

# Optional: Weather API Key
# WEATHER_API_KEY=your_weather_api_key

# Server Port (Railway sets this automatically, default 3001)
PORT=3001

# Node Environment
NODE_ENV=production
